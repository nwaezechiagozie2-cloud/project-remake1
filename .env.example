APP_ENV=development
APP_NAME=One-Tap Closer Remake
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/one_tap_closer
REDIS_URL=redis://localhost:6379/0

WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0

# --- Instagram ---
# If IG and WhatsApp share the same Meta App, use the same app secret
INSTAGRAM_VERIFY_TOKEN=replace_me
INSTAGRAM_APP_SECRET=

JWT_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=168
JWT_MIN_SECRET_LENGTH=32

AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM Provider ---
# Set to "gemini" or "nvidia"
ACTIVE_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
GOOGLE_CUSTOMER_GROUP_RESOURCE=
